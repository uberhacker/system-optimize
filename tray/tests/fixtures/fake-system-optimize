#!/usr/bin/env python3
"""A stand-in for system-optimize that speaks the full JSON interface the
tray expects (see tray/README.md). FAKE_SO_MODE=old makes it answer like
2.0.0 (no --json, no capabilities). FAKE_SO_LOG, when set, gets one line
per call."""
import json
import os
import sys

args = sys.argv[1:]
mode = os.environ.get("FAKE_SO_MODE", "new")
if os.environ.get("FAKE_SO_LOG"):
    with open(os.environ["FAKE_SO_LOG"], "a") as fh:
        fh.write(" ".join(args) + "\n")

STEPS = [
    ("sysctl", "default", True, "Kernel memory settings"), ("io", "default", True, "Disk schedulers"),
    ("cpu", "default", True, "CPU power profile"), ("limits", "default", False, "Open-file limits"),
    ("trim", "default", True, "SSD trim"), ("tools", "default", False, "Helper tools"),
    ("tuned", "opt-in", False, "tuned profile"), ("caching", "opt-in", True, "Download caching"),
    ("network", "opt-in", False, "Network"), ("fonts", "opt-in", False, "Font rendering"),
    ("cleanup", "opt-in", False, "Cleanup"), ("battery", "opt-in", False, "Battery care"),
]
HELP_OLD = """Usage: system-optimize [options]
  -n, --dry-run    print what would change
      --status     read-only report
      --undo [ID]  restore a snapshot
      --only LIST  run only these steps
Steps for --only/--skip: legacy, sysctl, io, cpu, limits, trim, tools
"""
HELP_NEW = HELP_OLD.replace("--only LIST  run only these steps",
                            "--only LIST  run only these steps\n      --enable LIST\n      --profile NAME\n"
                            "      --benchmark-only\n      --history\n      --describe STEP\n      --json\n"
                            "      --safe-apply") + "Optional steps for --enable: tuned, caching, network, fonts, cleanup, battery\n"


def bench(i, day, cpu, mem, disk):
    b = {"id": "b%d" % i, "time": "2026-10-%02dT09:00:00-04:00" % day, "snapshot": None, "profile": None,
         "scores": {"cpu": cpu, "memory": mem, "disk": disk, "overall": round((cpu + mem + disk) / 3, 1)},
         "units": {"cpu": "index", "memory": "index", "disk": "index", "overall": "index"}}
    if i >= 4:   # llama-bench was installed from the 4th run on
        b["scores"].update({"llm_pp": 480.0 + 10 * i, "llm_tg": 36.0 + 0.5 * i, "llm_model": "qwen3:4b"})
        b["units"].update({"llm_pp": "tok/s", "llm_tg": "tok/s"})
    return b


HISTORY = {
    "benchmarks": [bench(1, 3, 100, 100, 100), bench(2, 6, 101, 99, 100), bench(3, 9, 104, 103, 101),
                   bench(4, 13, 105, 104, 108), bench(5, 18, 104, 106, 109), bench(6, 22, 109, 107, 110),
                   bench(7, 27, 110, 108, 112)],
    "changes": [
        {"time": "2026-10-08T21:10:00-04:00", "snapshot": "20261008-211000", "step": "sysctl", "kind": "sysctl",
         "target": "vm.swappiness", "old": "60", "new": "180", "undone": False,
         "benchmark_before": "b2", "benchmark_after": "b3"},
        {"time": "2026-10-08T21:10:01-04:00", "snapshot": "20261008-211000", "step": "sysctl", "kind": "sysctl",
         "target": "vm.dirty_bytes", "old": "0", "new": "268435456", "undone": False,
         "benchmark_before": "b2", "benchmark_after": "b3"},
        {"time": "2026-10-12T20:00:00-04:00", "snapshot": "20261012-200000", "step": "io", "kind": "sysfs",
         "target": "nvme0n1 scheduler", "old": "mq-deadline", "new": "none", "undone": False,
         "benchmark_before": "b3", "benchmark_after": "b4"},
        {"time": "2026-10-20T19:30:00-04:00", "snapshot": "20261020-193000", "step": "caching", "kind": "file",
         "target": "/etc/dnf/dnf.conf max_parallel_downloads", "old": "3", "new": "10", "undone": False,
         "benchmark_before": "b5", "benchmark_after": "b6"},
    ],
}

if "--help" in args:
    print(HELP_OLD if mode == "old" else HELP_NEW)
elif "--version" in args:
    print("system-optimize %s" % ("2.0.0" if mode == "old" else "2.1.0"))
elif "--status" in args and "--json" in args and mode != "old":
    print(json.dumps({
        "version": "system-optimize 2.1.0",
        "capabilities": ["undo", "enable", "revert-step", "profile", "benchmark", "history", "describe", "safe-apply"],
        "steps": [{"name": n, "kind": k, "applied": a, "title": t} for n, k, a, t in STEPS],
        "profiles": ["dev", "gaming", "battery", "llm"], "profile": "dev",
        "snapshots": [{"id": "20261020-193000", "summary": "1 change", "undone": False}],
        "warnings": ([{"id": "bpftune-sysctl", "text": "bpftune is running, so the sysctl step leaves its keys alone."}]
                     if os.environ.get("FAKE_SO_WARNINGS") else []),
    }))
elif "--status" in args:
    print("system-optimize %s\n\nSystem\n  os  Fedora Linux 45\n" % ("2.0.0" if mode == "old" else "2.1.0"))
elif "--describe" in args and mode != "old":
    name = args[args.index("--describe") + 1]
    print(json.dumps({"name": name, "title": dict((n, t) for n, _, _, t in STEPS).get(name, name),
                      "summary": "what %s changes" % name,
                      "doc": "## %s\n\nSets the kernel's memory settings for your RAM and swap.\n\n"
                             "| Setting | Now | Sets |\n|---|---|---|\n| vm.swappiness | 60 | 180 |\n\n"
                             "**Undo** restores the previous values." % name,
                      "changes": [{"kind": "sysctl", "target": "vm.swappiness", "current": "60", "wanted": "180"}]}))
elif "--history" in args and mode != "old":
    h = dict(HISTORY)
    if "--step" in args:
        step = args[args.index("--step") + 1]
        h["changes"] = [c for c in HISTORY["changes"] if c["step"] == step]
    print(json.dumps(h))
elif "--benchmark-only" in args:
    print("cpu 110 memory 108 disk 112 overall 110")
elif "--dry-run" in args:
    print("dry run: nothing will be changed\n  sysctl  would set vm.swappiness 60 -> 180")
else:
    rc = int(os.environ.get("FAKE_SO_RC", "0"))
    print("ran: %s" % " ".join(args))
    sys.exit(rc)
