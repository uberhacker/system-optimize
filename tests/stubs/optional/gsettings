#!/usr/bin/env bash
# gsettings stub: each key's value lives in STUB_STATE/gsettings/SCHEMA KEY
# (a key without a file does not exist). Tests set one with gs_put; gs_range
# gives a flags key its allowed names (SCHEMA KEY.range), which "range"
# prints and "set" enforces, as gsettings does.
printf 'gsettings %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
d="${STUB_STATE:-/tmp}/gsettings"
case "${1:-}" in
  get) [ -f "$d/$2 $3" ] || { echo "No such key “$3”" >&2; exit 1; }; cat "$d/$2 $3" ;;
  set) [ -f "$d/$2 $3" ] || { echo "No such key “$3”" >&2; exit 1; }
       if [ -f "$d/$2 $3.range" ]; then
         for x in $(grep -o "'[^']*'" <<< "$4" | tr -d "'"); do
           grep -qxF "$x" "$d/$2 $3.range" || { echo "The provided value is outside of the valid range" >&2; exit 1; }
         done
       fi
       printf '%s\n' "$4" > "$d/$2 $3" ;;
  range) [ -f "$d/$2 $3.range" ] || exit 0; echo flags; sed "s/.*/'&'/" "$d/$2 $3.range" ;;
  reset) rm -f "$d/$2 $3" ;;
  list-keys) [ -e "$d/$2.schema" ] || ls "$d" 2>/dev/null | grep -q "^$2 " || { echo "No such schema “$2”" >&2; exit 1; }
       ls "$d" 2>/dev/null | sed -n "s/^$2 \([^.]*\)$/\1/p" ;;
esac
exit "${STUB_EXIT_gsettings:-0}"
