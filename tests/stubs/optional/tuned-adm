#!/usr/bin/env bash
# tuned-adm stub: the profile lives in STUB_STATE/tuned (default balanced).
printf 'tuned-adm %s\n' "$*" >> "${STUB_LOG:-/dev/null}"
f="${STUB_STATE:-/tmp}/tuned"
cur=$(cat "$f" 2>/dev/null || echo balanced)
case "${1:-}" in
  active) echo "Current active profile: $cur" ;;
  list)
    echo "Available profiles:"
    echo "- balanced                    - General non-specialized tuned profile"
    echo "- powersave                   - Optimize for low power consumption"
    echo "- throughput-performance      - Broadly applicable tuning that provides excellent performance"
    for p in ${STUB_TUNED_EXTRA:-}; do echo "- $p"; done
    echo "Current active profile: $cur" ;;
  profile) shift; echo "$*" > "$f" ;;
  off) echo none > "$f" ;;
esac
exit "${STUB_EXIT_tuned_adm:-0}"
