#!/usr/bin/env bash
# system-optimize - tune a Linux machine for its hardware, reversibly:
# kernel settings sized to its RAM and swap, disk I/O schedulers, the CPU
# power profile, open-file limits and SSD trim, plus a report of the
# well-known helpers (tuned, earlyoom, systemd-oomd, zram, irqbalance, ...)
# that can install the missing ones. Every real run saves a snapshot that
# --undo restores.
#
# The entry point. It resolves its own location through symlinks, loads the
# modules from ../lib and runs. Requires bash 4.4 or newer.
#
# A modular rewrite of Ed Reel's system-optimize
# (https://github.com/uberhacker/system-optimize). GPL-3.0, see LICENSE.

set -uo pipefail

if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 4 ]; }; then
  echo "system-optimize needs bash 4.4 or newer (found ${BASH_VERSION:-unknown})" >&2
  exit 1
fi

# The core relies on a few external commands (coreutils or BusyBox, grep,
# sed); say which one is missing up front instead of failing inside a step.
for _so_cmd in mktemp readlink grep sed sort; do
  if ! command -v "$_so_cmd" >/dev/null 2>&1; then
    echo "system-optimize needs '$_so_cmd' on PATH (coreutils or BusyBox, grep and sed are required)" >&2
    exit 1
  fi
done
unset _so_cmd

# so_resolve_self: absolute path of this file, following symlinks.
so_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}
# SO_BIN is this program's real path. SO_ROOT_DIR is the tree it was loaded
# from: the directory above bin/, or for a single-file build the directory
# holding the file. SO_BUNDLED is a build constant, not a setting: build.sh
# rewrites the next line to SO_BUNDLED=1.
SO_BUNDLED=0
SO_BIN=$(so_resolve_self)
if [ "$SO_BUNDLED" = 1 ]; then
  SO_ROOT_DIR=$(dirname "$SO_BIN")
else
  SO_ROOT_DIR=$(cd -P "$(dirname "$SO_BIN")/.." && pwd)
fi
export SO_ROOT_DIR

# Modules. build.sh replaces everything between the two markers with the
# modules' contents to make the single-file build.
